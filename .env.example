# Microsoft Clarity project ID. The Clarity script loads only after cookie consent.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Public website origin used for canonical and social metadata.
NEXT_PUBLIC_SITE_URL=https://eliyo.app

# Server-only Eliyo Lab connection. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# At least 32 random bytes, used to HMAC network abuse signals.
ELIYO_LAB_HASH_SECRET=
